# Copy to .env and fill in. Everything has a working default except
# SESSION_SECRET, which you should always set in production.

# Sessions and validated room access codes survive restarts only when this is
# set. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Bind address and port (defaults shown; Docker/Dokploy use these as-is)
PORT=3000
HOST=0.0.0.0

# The public URL(s) your instance is reached at, comma-separated. Required when
# deploying anywhere other than localhost, or browsers get CORS-blocked.
# Example: ALLOWED_ORIGINS=https://chat.example.com
# Example (raw IP): ALLOWED_ORIGINS=http://203.0.113.5:3000
ALLOWED_ORIGINS=

# Where runtime JSON state (rooms, Talkoboard strokes, saved themes) is
# written. Unset = repo root (classic behavior). Docker sets this to /app/data.
# DATA_DIR=./data

# Reverse-proxy hops to trust for real client IPs / HTTPS detection.
# Default 1 (Dokploy/Traefik, Cloudflare, nginx). Set 0 if directly exposed.
# TRUST_PROXY=1
